{
  "name": "aws-micro-next-hono",
  "private": true,
  "workspaces": [
    "services/*",
    "bff",
    "web"
  ],
  "scripts": {
    "dev": "npm-run-all -p dev:*",
    "dev:users": "npm --workspace services/users run dev",
    "dev:bff": "npm --workspace bff run dev",
    "dev:web": "npm --workspace web run dev"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "tsx": "^4.7.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}